rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User helpers
    function isValidUser(data) {
      return data.email is string && 
             data.email.size() <= 200 &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isEmailVerified() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isEmailVerified() && request.auth.uid == userId && 
                       isValidUser(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Track helpers
    function isValidTrack(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.createdAt == request.time;
    }

    match /tracks/{trackId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isEmailVerified() && isValidTrack(request.resource.data);
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }
  }
}
